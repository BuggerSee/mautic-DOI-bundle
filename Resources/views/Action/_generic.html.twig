<div class="mauticform-row doi-action-panel{% if action.settings.allowCampaignForm is not defined %} action-standalone-only{% endif %}"
     id="mauticform_doi-action_{{ id }}"
     data-doi-action="{{ id }}"
>
    <div class="doi-action-header">
        {% if inForm is defined %}
            {{ include('@LeuchtfeuerDoi/Builder/_actions.html.twig', {
                'id': id,
                'route': 'mautic_doi_formaction_action',
                'actionType': 'action',
                'formId': formId,
            }) }}
        {% endif %}
        <a data-toggle="ajaxmodal" data-target="#formComponentModal" href="{{ path('mautic_doi_formaction_action', {'objectAction': 'edit', 'objectId': id, 'formId': formId}) }}"><span class="action-label">{{ action.name }}</span></a>
        {% if action.description is not empty %}
            <span class="action-descr">{{ action.description|purify }}</span>
        {% endif %}
    </div>

    <div class="doi-add-conditions-button-wrapper" data-add-doi-conditions-button-wrapper="{{ id }}">
        <a href="#" data-add-doi-conditions-button="{{ id }}">
            <i class="ri-add-line"></i> {{ 'mautic.plugin.doi.form.button.add_conditions'|trans }}
        </a>
    </div>

    <div class="doi-action-condition-builder-wrapper" data-doi-action-condition-builder-wrapper="{{ id }}">
        <div class="row">
            <div class="col-md-4" data-doi-action-available-conditions-list-container></div>
        </div>
        <div class="doi-action-condition-builder-container" data-doi-action-condition-list="{{ id }}"></div>
    </div>
</div>
